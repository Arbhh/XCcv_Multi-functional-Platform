xccv/engine/weights/*
!xccv/engine/weights/download_weights.py
!xccv/engine/weights/ensure_weight.py
!xccv/engine/weights/ensure_family_weights.py
!xccv/engine/weights/__init__.py
*.pt
*.pth
*.onnx
*.engine
*.xva
*.xcs
