{
 "template": "tmpl_crop_export",
 "title": "斑点裁图导出 + 检出表格",
 "description": "载图 → 斑点分析（输出检出格式）→ 按检出裁图（取最大目标、外扩 20%、补方、最小边 32）→ 保存裁图图像；检出同时写入 CSV 表格（Excel 可直接打开）。适合把缺陷/零件逐个裁出做存档或二次标注；「按检出裁图」设置落盘目录后可一次保存全部目标的裁图。无需 AI 模型。",
 "last_node_id": 5, "last_link_id": 5,
 "nodes": [
  {"id": 1, "type": "xccv2/image_loader", "pos": [60, 220],
   "properties": {"path": "", "is_grayscale": false},
   "inputs": [], "outputs": [{"name": "image", "type": "image", "links": [1, 5]}]},
  {"id": 2, "type": "xccv2/blob_analysis", "pos": [330, 120],
   "properties": {"threshold_mode": "otsu", "thresh": 128.0, "invert": false,
                   "min_area": 20, "max_area": 0, "circularity": 0.0, "label_name": "目标"},
   "inputs": [{"name": "image", "type": "image", "link": 1}],
   "outputs": [{"name": "detection", "type": "detection", "links": [2, 3]},
                {"name": "centers", "type": "geometry", "links": []}]},
  {"id": 3, "type": "xccv2/crop_by_detection", "pos": [620, 300],
   "properties": {"select": "largest", "index": 0, "margin_pct": 20.0, "square": true,
                   "min_side": 32, "save_dir": "", "name_prefix": "crop"},
   "inputs": [{"name": "image", "type": "image", "link": 5},
               {"name": "detection", "type": "detection", "link": 2}],
   "outputs": [{"name": "image", "type": "image", "links": [4]}]},
  {"id": 4, "type": "xccv2/image_sink", "pos": [900, 300],
   "properties": {"out_dir": "", "what": "image", "fmt": "png", "quality": 95, "name_suffix": "_crop"},
   "inputs": [{"name": "image", "type": "image", "link": 4},
               {"name": "detection", "type": "detection", "link": null}],
   "outputs": [{"name": "saved", "type": "bool", "links": []}]},
  {"id": 5, "type": "xccv2/csv_sink", "pos": [620, -80],
   "properties": {"out_path": "", "columns": "source,time,label,score,x1,y1,x2,y2,bbox_area", "append": true},
   "inputs": [{"name": "detection", "type": "detection", "link": 3},
               {"name": "measure", "type": "measure", "link": null},
               {"name": "number", "type": "number", "link": null},
               {"name": "passed", "type": "bool", "link": null}],
   "outputs": [{"name": "saved", "type": "bool", "links": []}]}
 ],
 "links": [[1, 1, 0, 2, 0], [5, 1, 0, 3, 0], [2, 2, 0, 3, 1], [4, 3, 0, 4, 0], [3, 2, 0, 5, 0]]
